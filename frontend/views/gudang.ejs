<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { bioroots: { light: '#fef08a', DEFAULT: '#eab308', dark: '#854d0e' } } } }
        }
    </script>
    <script src="<%= socketUrl %>/socket.io/socket.io.js"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-sans antialiased min-h-screen flex flex-col">

    <nav class="bg-bioroots-dark text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <svg class="w-8 h-8 text-bioroots-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
                <h1 class="text-2xl font-bold tracking-wider">Gudang & Logistik</h1>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm font-medium">Halo, <%= user.nama %> (<%= user.username %>)</span>
                <a href="/logout"
                    class="bg-red-500 hover:bg-red-600 px-3 py-1 rounded text-sm font-bold transition">Logout</a>
            </div>
        </div>
    </nav>

    <main class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 animate-fade-in space-y-8">
        <div id="toastContainer" class="fixed top-20 right-5 z-50 space-y-2"></div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                <div class="flex justify-between items-end mb-4">
                    <div>
                        <h2 class="text-xl font-bold text-gray-800">📤 Outbound (Workspace: <%= user.username %>)</h2>
                        <p class="text-xs text-gray-500 mt-1">Siapkan pesanan lunas ke Kurir. Data terisolasi.</p>
                    </div>
                    <button onclick="loadOrders()"
                        class="bg-gray-100 hover:bg-gray-200 text-gray-700 p-2 rounded-lg transition text-xs font-bold">Refresh</button>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-2 text-left text-xs font-bold text-gray-500 uppercase">Order ID</th>
                                <th class="px-4 py-2 text-left text-xs font-bold text-gray-500 uppercase">Isi Paket
                                    (Barang)</th>
                                <!-- <th class="px-4 py-2 text-left text-xs font-bold text-gray-500 uppercase">Status</th> -->
                                <th class="px-4 py-2 text-right text-xs font-bold text-gray-500 uppercase">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tableOutbound" class="bg-white divide-y divide-gray-200">
                            <tr>
                                <td colspan="4" class="px-4 py-4 text-center text-sm text-gray-500">Memuat...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                <div class="flex justify-between items-end mb-4">
                    <div>
                        <h2 class="text-xl font-bold text-gray-800">📥 Inbound (Stok Masuk)</h2>
                        <p class="text-xs text-gray-500 mt-1">Catat pasokan bibit baru ke sistem.</p>
                    </div>
                    <button onclick="loadKatalog()"
                        class="bg-gray-100 hover:bg-gray-200 text-gray-700 p-2 rounded-lg transition text-xs font-bold">Refresh</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-2 text-left text-xs font-bold text-gray-500 uppercase">Bibit</th>
                                <th class="px-4 py-2 text-center text-xs font-bold text-gray-500 uppercase">Stok Saat
                                    Ini</th>
                                <th class="px-4 py-2 text-right text-xs font-bold text-gray-500 uppercase">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tableInbound" class="bg-white divide-y divide-gray-200">
                            <tr>
                                <td colspan="3" class="px-4 py-4 text-center text-sm text-gray-500">Memuat katalog...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <script>
        const CURRENT_USER = "<%= user.username %>";
        const API_URL = "<%= apiUrl %>";
    </script>

    <script>
        const tableOutbound = document.getElementById('tableOutbound');
        const tableInbound = document.getElementById('tableInbound');
        const toastContainer = document.getElementById('toastContainer');

        // ==========================================
        // 1. OUTBOUND (PACKING DENGAN POOL & CLAIM)
        // ==========================================
        async function loadOrders() {
            try {
                const res = await fetch(`${API_URL}/pesanan`);
                const data = await res.json();

                // FILTER: Logika "Pool & Claim" untuk Gudang
                const myOrders = data.filter(order => {
                    // Manager lihat semua
                    if (!CURRENT_USER.startsWith('gudang')) return true;

                    // KONDISI 1: Pesanan baru lunas dari Kasir (Antrean Terbuka Gudang)
                    if (order.status_aktual === 'PAID') return true;

                    // KONDISI 2: Pesanan sudah dikerjakan (PACKED/DELIVERED)
                    // HANYA tampilkan untuk anak gudang yang mengemasnya!
                    if (order.status_aktual === 'PACKED' || order.status_aktual === 'DELIVERED') {
                        return order.id_gudang === CURRENT_USER;
                    }

                    return false;
                });

                renderOutboundTable(myOrders);
            } catch (error) {
                tableOutbound.innerHTML = `<tr><td colspan="4" class="text-center text-red-500 py-4">Gagal memuat pesanan.</td></tr>`;
            }
        }

        function renderOutboundTable(orders) {
            if (orders.length === 0) {
                tableOutbound.innerHTML = `<tr><td colspan="4" class="px-4 py-4 text-center text-gray-500 text-sm">Tidak ada barang untuk dipacking.</td></tr>`;
                return;
            }

            tableOutbound.innerHTML = orders.map(order => {
                let itemsHtml = '-';
                if (order.items) {
                    const parsedItems = typeof order.items === 'string' ? JSON.parse(order.items) : order.items;
                    itemsHtml = parsedItems.map(item =>
                        `<div class="text-xs bg-gray-50 border border-gray-200 text-gray-700 rounded px-2 py-1 mb-1 block">
                            <span class="font-bold text-bioroots-dark">${item.qty_dus}x</span> ${item.nama_bibit}
                        </div>`
                    ).join('');
                }

                // LOGIKA MINIMALIS:
                // Jika PAID -> Tampilkan tombol Bungkus!
                // Jika PACKED -> Tampilkan tanda centang Siap Pickup
                let actionContent = order.status_aktual === 'PAID'
                    ? `<button onclick="prosesPacking('${order.order_id}')" class="bg-bioroots hover:bg-yellow-600 text-white text-xs font-bold py-1.5 px-3 rounded w-full shadow">Bungkus!</button>`
                    : `<div class="text-green-600 font-bold text-xs">✅ Siap Pickup</div>`;

                return `
                    <tr class="hover:bg-gray-50 align-top">
                        <td class="px-4 py-3 text-sm font-bold text-gray-900">
                            <div title="${order.order_id}">${order.order_id.substring(0, 13)}...</div>
                            <div class="text-[10px] text-gray-500 font-normal mt-1">${order.nama_pembeli || order.id_pembeli}</div>
                        </td>
                        <td class="px-4 py-3 min-w-[150px]">${itemsHtml}</td>
                        <td class="px-4 py-3 text-right">${actionContent}</td>
                    </tr>
                `;
            }).join('');
        }

        async function prosesPacking(orderId) {
            if (!confirm(`Tandai pesanan lunas ini selesai dipacking?`)) return;
            try {
                const res = await fetch(`${API_URL}/gudang/pack`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ order_id: orderId, id_gudang: CURRENT_USER }) // Pastikan variabelnya id_gudang
                });

                const result = await res.json();

                if (res.ok) {
                    showToast('📦 Packing Selesai', `Pesanan ${orderId} sudah menjadi milik Anda & siap dikirim!`, 'bg-bioroots');
                    socket.emit('gudang_diklaim'); // Trigger refresh ke semua gudang lain
                    loadOrders();
                } else {
                    alert(result.error);
                    loadOrders(); // Refresh karena sudah direbut orang
                }
            } catch (error) { alert('Kesalahan jaringan!'); }
        }

        // ==========================================
        // 2. INBOUND STOK (SAMA SEPERTI SEBELUMNYA)
        // ==========================================
        async function loadKatalog() {
            try {
                const res = await fetch(`${API_URL}/inventaris`);
                const data = await res.json();

                tableInbound.innerHTML = data.map(item => `
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 text-sm">
                            <div class="font-bold text-gray-900">${item.nama_bibit}</div>
                            <div class="text-[10px] text-gray-400">${item.sku}</div>
                        </td>
                        <td class="px-4 py-3 text-center text-sm font-bold ${item.stok_aktual_dus < 50 ? 'text-red-500' : 'text-green-600'}">
                            ${item.stok_aktual_dus}
                        </td>
                        <td class="px-4 py-3 text-right">
                            <button onclick="tambahStok('${item.sku}', '${item.nama_bibit}')" class="bg-gray-800 hover:bg-black text-white text-[10px] font-bold py-1.5 px-3 rounded transition">
                                + INBOUND
                            </button>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                tableInbound.innerHTML = `<tr><td colspan="3" class="text-center text-red-500 py-4">Gagal memuat katalog.</td></tr>`;
            }
        }

        async function tambahStok(idBibit, namaBibit) {
            const jumlah = prompt(`Berapa dus pasokan masuk untuk ${namaBibit}?`, "100");
            if (!jumlah || isNaN(jumlah) || parseInt(jumlah) <= 0) return;

            try {
                const res = await fetch(`${API_URL}/gudang/inbound`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sku: idBibit, qty_masuk_dus: parseInt(jumlah), id_aktor_gudang: CURRENT_USER })
                });

                if (res.ok) {
                    showToast('📥 Inbound Berhasil', `Stok bertambah ${jumlah} dus.`, 'bg-blue-600');
                    loadKatalog();
                } else {
                    const result = await res.json();
                    alert('Gagal: ' + result.error);
                }
            } catch (error) { alert('Kesalahan jaringan!'); }
        }

        // ==========================================
        // UI HELPER & WEBSOCKET
        // ==========================================
        function showToast(title, message, bgColor) {
            const toast = document.createElement('div');
            toast.className = `${bgColor} text-white px-4 py-3 rounded-lg shadow-lg animate-fade-in max-w-sm`;
            toast.innerHTML = `<strong>${title}</strong><br><span class="text-sm">${message}</span>`;
            toastContainer.appendChild(toast);
            setTimeout(() => { toast.remove(); }, 5000);
        }

        const socket = io('<%= socketUrl %>');

        // Refresh saat kasir selesai bayar (masuk ke antrean gudang)
        socket.on('payment_completed', () => {
            showToast('💰 Pesanan Masuk', `Kasir baru saja melunasi pesanan. Siapkan barang!`, 'bg-blue-500');
            loadOrders();
        });

        // Refresh live untuk inbound/outbound
        socket.on('stock_updated', () => loadKatalog());
        socket.on('packing_completed', () => loadOrders());

        // Load data awal
        loadOrders();
        loadKatalog();
    </script>
</body>

</html>