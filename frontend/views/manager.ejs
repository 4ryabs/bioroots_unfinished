<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { bioroots: { light: '#cbd5e1', DEFAULT: '#334155', dark: '#0f172a' } } } } // Tema Slate/Executive
        }
    </script>
    <script src="<%= socketUrl %>/socket.io/socket.io.js"></script>
</head>

<body class="bg-gray-100 text-gray-800 font-sans antialiased min-h-screen flex flex-col">

    <nav class="bg-bioroots-dark text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                    </path>
                </svg>
                <h1 class="text-2xl font-bold tracking-wider">Executive Dashboard</h1>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm font-medium text-gray-300">Pusat Kendali Utama</span>
                <a href="/logout"
                    class="bg-red-500 hover:bg-red-600 px-4 py-1.5 rounded text-sm font-bold transition shadow">Logout</a>
            </div>
        </div>
    </nav>

    <main class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 animate-fade-in space-y-6">

        <div id="toastContainer" class="fixed top-20 right-5 z-50 space-y-2"></div>

        <div class="flex justify-between items-end mb-2">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Analitik Sistem Terdistribusi</h2>
                <p class="text-sm text-gray-500">Data ditarik secara real-time dari Audit Logs MongoDB & Relasional
                    MySQL.</p>
            </div>
            <button onclick="loadDashboardData()"
                class="flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                    </path>
                </svg>
                Sinkronisasi Ulang
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                    <h3 class="text-lg font-bold text-gray-800">Alur Event Sistem (Real-time Audit - MongoDB)</h3>
                </div>
                <div class="overflow-x-auto max-h-[320px] overflow-y-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Waktu
                                    (HH:mm:ss)</th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Event / Divisi
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Order ID</th>
                            </tr>
                        </thead>
                        <tbody id="tableEventFlow" class="bg-white divide-y divide-gray-200">
                            <tr>
                                <td colspan="3" class="px-6 py-4 text-center text-sm text-gray-500">Memuat log audit...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="space-y-4">
                <div class="bg-gradient-to-br from-green-500 to-green-600 p-6 rounded-xl shadow text-white">
                    <h4 class="text-sm font-bold uppercase tracking-wider opacity-80">Total Sesi Inbound</h4>
                    <p id="totalInbound" class="text-4xl font-bold mt-2">0</p>
                </div>
                <div class="bg-gradient-to-br from-blue-500 to-blue-600 p-6 rounded-xl shadow text-white">
                    <h4 class="text-sm font-bold uppercase tracking-wider opacity-80">Total Transaksi Kasir</h4>
                    <p id="totalKasir" class="text-4xl font-bold mt-2">0</p>
                </div>
                <div class="bg-gradient-to-br from-purple-500 to-purple-600 p-6 rounded-xl shadow text-white">
                    <h4 class="text-sm font-bold uppercase tracking-wider opacity-80">Total Pengiriman Kurir</h4>
                    <p id="totalKurir" class="text-4xl font-bold mt-2">0</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mt-6">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-bold text-gray-800">Daftar Seluruh Transaksi Terkini (MySQL Master)</h3>
            </div>
            <div class="overflow-x-auto max-h-[400px] overflow-y-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Order ID & Waktu</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Pembeli</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Detail Item</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Total Bayar</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Status Aktual</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="bg-white divide-y divide-gray-200">
                        <tr>
                            <td colspan="5" class="px-6 py-4 text-center text-sm text-gray-500">Memuat data transaksi...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script>
        const API_URL = "<%= apiUrl %>";
        const tableEventFlow = document.getElementById('tableEventFlow');
        const tableBody = document.getElementById('tableBody');
        const toastContainer = document.getElementById('toastContainer');

        function formatRupiah(angka) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(angka);
        }

        // FUNGSI UTAMA: Ambil log MongoDB dan data pesanan MySQL bersamaan
        async function loadDashboardData() {
            try {
                // 1. Ambil data analitik & audit log dari MongoDB
                const resMongo = await fetch(`${API_URL}/manager/analytics`);
                if (resMongo.ok) {
                    const dataMongo = await resMongo.json();
                    renderMongoData(dataMongo);
                }

                // 2. Ambil data pesanan real-time dari MySQL
                const resMysql = await fetch(`${API_URL}/pesanan`);
                if (resMysql.ok) {
                    const dataMysql = await resMysql.json();
                    renderMysqlTable(dataMysql);
                }
            } catch (error) {
                console.error("Kesalahan jaringan saat sinkronisasi:", error);
            }
        }

        // Render Bagian MongoDB (Cards & Audit Log)
        function renderMongoData(data) {
            const stats = data.eventStats || [];
            const events = data.recentEvents || [];

            // Update Angka Summary Cards
            const inboundCount = stats.find(s => s._id?.includes('STOCK') || s._id === 'inbound_stok')?.count || 0;
            const kasirCount = stats.find(s => s._id?.includes('PAID') || s._id === 'transaksi_pos')?.count || 0;
            const kurirCount = stats.find(s => s._id?.includes('DELIVERED') || s._id === 'pengiriman_kurir')?.count || 0;

            document.getElementById('totalInbound').innerText = inboundCount;
            document.getElementById('totalKasir').innerText = kasirCount;
            document.getElementById('totalKurir').innerText = kurirCount;

            // Render Tabel Alur Event (Atas)
            if (events.length === 0) {
                tableEventFlow.innerHTML = `<tr><td colspan="3" class="px-6 py-4 text-center text-sm text-gray-500">Belum ada data log audit.</td></tr>`;
                return;
            }

            tableEventFlow.innerHTML = events.map(ev => {
                const time = new Date(ev.waktu_kejadian).toLocaleTimeString('id-ID', {
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                });
                const payload = ev.payload || {};
                const orderId = payload.order_id || ev.order_id || '-';

                return `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-3 text-sm font-mono text-gray-600">${time}</td>
                        <td class="px-6 py-3 text-sm font-bold text-blue-700">${ev.event_type}</td>
                        <td class="px-6 py-3 text-sm text-gray-900">${orderId}</td>
                    </tr>
                `;
            }).join('');
        }

        // Render Bagian MySQL (Tabel Utama Transaksi - Tanpa Kolom Aksi)
        function renderMysqlTable(orders) {
            if (orders.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">Belum ada transaksi di sistem.</td></tr>`;
                return;
            }

            tableBody.innerHTML = orders.map(order => {
                const date = new Date(order.waktu_transaksi).toLocaleString('id-ID');

                let itemsHtml = '-';
                if (order.items) {
                    const parsedItems = typeof order.items === 'string' ? JSON.parse(order.items) : order.items;
                    itemsHtml = parsedItems.map(item =>
                        `<div class="text-xs bg-gray-50 border border-gray-200 text-gray-700 rounded px-2 py-1 mb-1 block w-full">
                            <span class="font-bold text-bioroots-dark">${item.qty_dus}x</span> ${item.nama_bibit}
                        </div>`
                    ).join('');
                }

                let statusBadge = '';
                if (order.status_aktual === 'PENDING') {
                    statusBadge = `<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Menunggu Bayar</span>`;
                } else if (order.status_aktual === 'PAID') {
                    statusBadge = `<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Lunas (Di Gudang)</span>`;
                } else if (order.status_aktual === 'PACKED') {
                    statusBadge = `<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">Siap Dikirim</span>`;
                } else if (order.status_aktual === 'DELIVERED') {
                    statusBadge = `<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Selesai (Terkirim)</span>`;
                }

                return `
                    <tr class="hover:bg-gray-50 transition align-top">
                        <td class="px-6 py-4">
                            <div class="text-sm font-bold text-gray-900" title="${order.order_id}">${order.order_id.substring(0, 13)}...</div>
                            <div class="text-xs text-gray-500">${date}</div>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-700">
                            <div class="font-bold">${order.nama_pembeli || order.id_pembeli}</div>
                        </td>
                        <td class="px-6 py-4 min-w-[200px]">${itemsHtml}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${formatRupiah(order.total_bayar)}</td>
                        <td class="px-6 py-4 whitespace-nowrap">${statusBadge}</td>
                    </tr>
                `;
            }).join('');
        }

        function showToast(title, message) {
            const toast = document.createElement('div');
            toast.className = `bg-gray-800 text-white px-4 py-3 rounded-lg shadow-lg animate-fade-in max-w-sm`;
            toast.innerHTML = `<strong>${title}</strong><br><span class="text-sm text-gray-300">${message}</span>`;
            toastContainer.appendChild(toast);
            setTimeout(() => { toast.remove(); }, 5000);
        }

        // WEBSOCKET: Auto-refresh saat ada pergerakan event atau divisi lain menyelesaikan tugas
        const socket = io('<%= socketUrl %>');

        socket.on('system_alert', () => {
            showToast('📊 Log Sistem Masuk', 'Mendeteksi draft pesanan baru masuk ke antrean.');
            setTimeout(loadDashboardData, 800);
        });

        socket.on('payment_completed', () => {
            showToast('💰 Pembayaran Selesai', 'Ada pesanan yang baru dilunasi oleh Kasir.');
            loadDashboardData();
        });

        socket.on('packing_completed', () => {
            showToast('📦 Gudang Diperbarui', 'Pihak Logistik selesai mengemas barang.');
            loadDashboardData();
        });

        // Jalankan sinkronisasi pertama kali saat web dibuka
        loadDashboardData();
    </script>
</body>

</html>