<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { bioroots: { light: '#e0e7ff', DEFAULT: '#4f46e5', dark: '#312e81' } } } } // Tema Indigo/Ungu
        }
    </script>
    <script src="<%= socketUrl %>/socket.io/socket.io.js"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-sans antialiased min-h-screen flex flex-col">

    <nav class="bg-bioroots-dark text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <svg class="w-8 h-8 text-bioroots-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0">
                    </path>
                </svg>
                <div class="flex flex-col">
                    <h1 class="text-xl font-bold tracking-wider leading-tight">Armada Pengiriman</h1>
                    <span
                        class="text-[10px] bg-indigo-200 text-indigo-900 px-2 py-0.5 rounded-full font-bold w-max mt-1">
                        KURIR LOGISTIK
                    </span>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm font-medium hidden md:block">Halo, <%= user.nama %> (<%= user.username %>)</span>
                <a href="/logout"
                    class="bg-red-500 hover:bg-red-600 px-3 py-1.5 rounded text-sm font-bold transition shadow">Logout</a>
            </div>
        </div>
    </nav>

    <main class="flex-grow max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 animate-fade-in">

        <div id="toastContainer" class="fixed top-20 right-5 z-50 space-y-2"></div>

        <div class="flex justify-between items-end mb-6 border-b border-gray-200 pb-4">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Daftar Tugas Saya (<%= user.username %>)</h2>
                <p class="text-sm text-gray-500">Jemput paket dari lokasi yang ditentukan dan antar ke pelanggan.</p>
            </div>
            <button onclick="loadOrders()"
                class="flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                    </path>
                </svg>
                Refresh Data
            </button>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Order ID & Pembeli</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Lokasi Jemput & Barang</th>
                            <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Status / POD</th>
                            <th
                                class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider min-w-[150px]">
                                Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="bg-white divide-y divide-gray-200">
                        <tr>
                            <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">Memuat data penugasan...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- MODAL POD -->
        <div id="podModal"
            class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 backdrop-blur-sm">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-md p-6 transform transition-all scale-100">
                <div class="border-b pb-3 mb-4">
                    <h3 class="text-xl font-bold text-gray-900">Form Proof of Delivery (POD)</h3>
                    <p class="text-xs text-gray-500 mt-1">Konfirmasi paket telah sampai ke tangan pelanggan.</p>
                </div>

                <input type="hidden" id="podOrderId">

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Nama Penerima Paket *</label>
                        <input type="text" id="podPenerima" placeholder="Misal: Bapak Budi / Security / Satpam"
                            class="block w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Catatan Kondisi (Opsional)</label>
                        <textarea id="podCatatan" rows="2" placeholder="Misal: Ditaruh di teras, cuaca hujan..."
                            class="block w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"></textarea>
                    </div>
                </div>

                <div class="mt-6 flex justify-end gap-3">
                    <button onclick="closePodModal()"
                        class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg font-bold hover:bg-gray-200 transition">Batal</button>
                    <button onclick="submitPOD()"
                        class="px-5 py-2 bg-bioroots text-white rounded-lg font-bold hover:bg-indigo-700 transition shadow-md">Simpan
                        & Selesaikan</button>
                </div>
            </div>
        </div>

    </main>

    <script>
        const CURRENT_USER = "<%= user.username %>";
        const API_URL = "<%= apiUrl %>"; 
    </script>

    <script>
        const tableBody = document.getElementById('tableBody');
        const toastContainer = document.getElementById('toastContainer');
        const podModal = document.getElementById('podModal');

        // 1. Load Data
        async function loadOrders() {
            try {
                const res = await fetch(`${API_URL}/pesanan`);
                const data = await res.json();

                // FILTER LOGIKA BARU: MANAGER ASSIGNMENT
                const myOrders = data.filter(order => {
                    // Tampilkan HANYA pesanan yang ID Kurirnya sama dengan kurir yang login
                    if (order.id_kurir === CURRENT_USER) {
                        // Tampilkan pesanan yang sedang bertugas (PACKED) dan Riwayat (DELIVERED)
                        return order.status_aktual === 'PACKED' || order.status_aktual === 'DELIVERED';
                    }
                    return false;
                });

                renderTable(myOrders);
            } catch (error) {
                tableBody.innerHTML = `<tr><td colspan="4" class="px-6 py-4 text-center text-red-500">Gagal memuat data dari server.</td></tr>`;
            }
        }

        // 2. Render Tabel
        function renderTable(orders) {
            if (orders.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500 text-sm">Belum ada tugas pengiriman untuk Anda. Bersantai sejenak! ☕</td></tr>`;
                return;
            }

            tableBody.innerHTML = orders.map(order => {
                // Lokasi Gudang Penjemputan
                const lokasiPickup = order.id_gudang_tujuan === 'gudang1'
                    ? '<span class="bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded text-[10px] font-bold shadow-sm">🏭 JEMPUT DI GUDANG 1</span>'
                    : '<span class="bg-orange-100 text-orange-800 px-2 py-0.5 rounded text-[10px] font-bold shadow-sm">🏢 JEMPUT DI GUDANG 2</span>';

                // Render Detail Barang
                let itemsHtml = '-';
                if (order.items) {
                    const parsedItems = typeof order.items === 'string' ? JSON.parse(order.items) : order.items;
                    itemsHtml = parsedItems.map(item =>
                        `<div class="text-xs bg-gray-50 border border-gray-200 text-gray-700 rounded px-2 py-1 mb-1 block w-max">
                            <span class="font-bold text-indigo-700">${item.qty_dus}x</span> ${item.nama_bibit}
                        </div>`
                    ).join('');
                }

                let statusBadge = '';
                let actionBtn = '-';
                let podInfo = '<span class="text-gray-400 italic text-xs">Belum ada data</span>';

                if (order.status_aktual === 'PACKED') {
                    statusBadge = `<span class="px-2 inline-flex text-xs leading-5 font-bold rounded-full bg-yellow-100 text-yellow-800 border border-yellow-200 shadow-sm">Tugas Baru</span>`;
                    actionBtn = `<button onclick="openPodModal('${order.order_id}')" class="bg-bioroots hover:bg-indigo-700 text-white text-xs font-bold py-2 px-4 rounded-lg shadow-md transition transform hover:-translate-y-0.5 w-full">Antar & Input POD</button>`;
                } else if (order.status_aktual === 'DELIVERED') {
                    statusBadge = `<span class="px-2 inline-flex text-xs leading-5 font-bold rounded-full bg-green-100 text-green-800 border border-green-200 shadow-sm">Terkirim</span>`;
                    podInfo = `
                        <div class="text-sm font-bold text-gray-900 border-l-2 border-green-500 pl-2">Penerima: ${order.nama_penerima || '-'}</div>
                        <div class="text-[10px] text-gray-500 mt-1 pl-2 font-medium">Catatan: ${order.catatan_pod || 'Tidak ada catatan'}</div>
                    `;
                }

                return `
                    <tr class="hover:bg-gray-50 transition align-top">
                        <td class="px-6 py-4">
                            <div class="text-sm font-bold text-gray-900" title="${order.order_id}">${order.order_id.substring(0, 13)}...</div>
                            <div class="text-sm font-bold text-gray-700 mt-2">${order.nama_pembeli || order.id_pembeli}</div>
                            <div class="text-xs text-gray-500 flex items-start gap-1 mt-1" title="${order.alamat_pembeli || '-'}">
                                <span>📍</span> <span class="truncate max-w-[200px]">${order.alamat_pembeli || '-'}</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 min-w-[200px]">
                            <div class="mb-2">${lokasiPickup}</div>
                            ${itemsHtml}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="mb-2">${statusBadge}</div>
                            ${podInfo}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right align-middle">
                            ${actionBtn}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // 3. Logika Modal POD
        function openPodModal(orderId) {
            document.getElementById('podOrderId').value = orderId;
            document.getElementById('podPenerima').value = '';
            document.getElementById('podCatatan').value = '';
            podModal.classList.remove('hidden');
        }

        function closePodModal() {
            podModal.classList.add('hidden');
        }

        async function submitPOD() {
            const orderId = document.getElementById('podOrderId').value;
            const penerima = document.getElementById('podPenerima').value;
            const catatan = document.getElementById('podCatatan').value;

            if (!penerima) {
                alert('Nama Penerima wajib diisi sebagai Bukti Pengiriman (POD)!');
                document.getElementById('podPenerima').focus();
                return;
            }

            try {
                const res = await fetch(`${API_URL}/kurir/deliver`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        order_id: orderId,
                        id_kurir: CURRENT_USER,
                        nama_penerima: penerima,
                        catatan_pod: catatan
                    })
                });

                const result = await res.json();

                if (res.ok) {
                    closePodModal();
                    showToast('🚚 Pengiriman Sukses!', `Paket telah diterima oleh ${penerima}.`, 'bg-indigo-600');
                    socket.emit('delivery_completed'); // Beritahu Manager Gudang
                    loadOrders();
                } else {
                    alert('Gagal: ' + result.error);
                    loadOrders();
                }
            } catch (error) {
                alert('Kesalahan jaringan: ' + error.message);
            }
        }

        // 4. UI Helper
        function showToast(title, message, bgColor) {
            const toast = document.createElement('div');
            toast.className = `${bgColor} text-white px-4 py-3 rounded-xl shadow-2xl animate-fade-in max-w-sm border border-white/20`;
            toast.innerHTML = `<strong>${title}</strong><br><span class="text-sm opacity-90">${message}</span>`;
            toastContainer.appendChild(toast);
            setTimeout(() => { toast.remove(); }, 6000);
        }

        // 5. WEBSOCKET REAL-TIME
        const socket = io('<%= socketUrl %>');

        // Mendengarkan instruksi penugasan dari Manager Gudang
        socket.on('kurir_ditugaskan', () => {
            showToast('🚨 Tugas Baru Masuk!', `Manager baru saja menugaskan paket untuk Anda. Cek lokasi penjemputan!`, 'bg-indigo-600');
            loadOrders();
        });

        loadOrders();
    </script>
</body>

</html>